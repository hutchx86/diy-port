# Settings for scripts/diyport_service.sh (and the launchd agent scripts/macos_launchd.sh installs):
# copy to ~/.diyport.env and edit.
# One KEY=value per line (no spaces around =, no quotes needed). Only AIPORT_* and DIYPORT_*
# keys are used. Edit, then `touch ~/.diyport-restart` to apply.

# Identity: the adopted AI Port this host runs as (scripts/macos_move_host.sh moves it to another Mac).
DIYPORT_IFACE=en0
DIYPORT_STATE_DIR=/Users/you/.diyport-state
DIYPORT_MAC=020000000001
DIYPORT_DEVICE_ID=fe6488e7-7042-5bcb-ab86-6f0ad1a5baed

# Protect console and detection settings (diyport/README.md lists them all).
AIPORT_CONSOLE_HOST=192.0.2.1
# Optional CPU model; fetch_models.py installs yolov5n.onnx by default.
# AIPORT_MODEL_PATH=/Users/you/Code/diy-port/diyport/models/yolov9-s-320.onnx
AIPORT_TICK_S=0.2
AIPORT_BOX_DELAY_MS=1500,02000000000B=1800
AIPORT_TRUE_THRESH=0.7,vehicle=0.6
AIPORT_MOTION_CONTOUR_AREA=10,02000000000B=100
# Report each camera at half the real device's capacity points, so twice as many pair.
# AIPORT_POINTS_SCALE=0.5
# ~/diyport.log is rotated at this many MB, keeping this many old files (diyport.log.1 ...).
# Read at service start: apply with scripts/macos_launchd.sh restart, not ~/.diyport-restart.
# DIYPORT_LOG_MAX_MB=50
# DIYPORT_LOG_KEEP=5
